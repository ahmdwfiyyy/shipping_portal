# Copy this file to ".env" and fill in real values. Never commit ".env".
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Signs login tokens - use a long random string (at least 32 characters)
SECRET_KEY=put-a-long-random-string-here

# The first admin account, created only when the database has no users yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_FULL_NAME=Administrator

# Leave empty locally (an SQLite file in backend/data is used).
# On Vercel this MUST be a PostgreSQL database, e.g. from Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=
